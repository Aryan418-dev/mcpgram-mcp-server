{
  "name": "mcpgram-mcp-server",
  "version": "1.4.0",
  "description": "Official MCP server for MCPGRAM - stdio + Streamable HTTP + built-in OAuth 2.1 for Claude.ai",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcpgram-mcp-server": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "build": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "dev:next": "next dev"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcpgram",
    "streamable-http",
    "oauth"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@supabase/supabase-js": "^2.45.0",
    "jose": "^5.9.6",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "18.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
