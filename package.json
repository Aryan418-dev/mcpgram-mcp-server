{
  "name": "mcpgram-mcp-server",
  "version": "1.0.0",
  "description": "Official MCP server for MCPGRAM — exposes all workspace connectors and tools to Claude Desktop, Cursor, VS Code, OpenCode, OpenClaw, and any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcpgram-mcp-server": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcpgram",
    "claude",
    "cursor",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
