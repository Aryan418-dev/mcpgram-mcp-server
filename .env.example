# --- stdio mode (local clients) ---
MCPGRAM_API_KEY=mcpg_live_your_key_here

# --- both modes ---
MCPGRAM_BASE_URL=https://mcpgram.vercel.app
MCPGRAM_TIMEOUT_MS=30000
MCPGRAM_MAX_RETRIES=2
MCPGRAM_LOG_LEVEL=info

# --- HTTP mode ---
MCPGRAM_HTTP_PORT=3100
MCPGRAM_RATE_LIMIT_MAX=120
MCPGRAM_RATE_LIMIT_WINDOW_MS=60000

# --- Public base URL of THIS deployment ---
MCP_PUBLIC_URL=https://mcpgram-mcp-server.vercel.app

# --- Auth0 (Authorization Server for Claude.ai) ---
# Tenant domain only or full URL, e.g. your-tenant.us.auth0.com
AUTH0_DOMAIN=your-tenant.us.auth0.com
# Must match Auth0 API Identifier (resource / audience)
AUTH0_AUDIENCE=https://mcpgram-mcp-server.vercel.app/mcp
# Workspace API key used after Claude completes Auth0 login
MCPGRAM_OAUTH_API_KEY=mcpg_live_your_workspace_key

# --- Optional legacy homegrown OAuth (not used when Auth0 is set for Claude) ---
# OAUTH_JWT_SECRET=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
