# Required — workspace API key from MCPGRAM dashboard
# Dashboard → Workspace → API Keys → Create key
MCPGRAM_API_KEY=mcpg_live_your_key_here

# Optional — defaults to https://mcpgram.vercel.app
MCPGRAM_BASE_URL=https://mcpgram.vercel.app

# Optional — request timeout in ms (default 30000)
MCPGRAM_TIMEOUT_MS=30000

# Optional — max retries on transient HTTP errors (default 2)
MCPGRAM_MAX_RETRIES=2

# Optional — log level: debug | info | warn | error (default info)
# Logs go to stderr so they never corrupt the MCP stdio protocol
MCPGRAM_LOG_LEVEL=info
