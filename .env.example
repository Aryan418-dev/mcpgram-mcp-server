# --- stdio mode (local clients) ---
# Required for `npm start` / Claude Desktop
MCPGRAM_API_KEY=mcpg_live_your_key_here

# --- both modes ---
MCPGRAM_BASE_URL=https://mcpgram.vercel.app
MCPGRAM_TIMEOUT_MS=30000
MCPGRAM_MAX_RETRIES=2
MCPGRAM_LOG_LEVEL=info

# --- HTTP mode ---
# Port for `npm run start:http` (Vercel sets PORT automatically)
MCPGRAM_HTTP_PORT=3100
# Per-key rate limit (HTTP only)
MCPGRAM_RATE_LIMIT_MAX=120
MCPGRAM_RATE_LIMIT_WINDOW_MS=60000
