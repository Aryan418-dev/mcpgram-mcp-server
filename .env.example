# --- stdio mode (local clients) ---
MCPGRAM_API_KEY=mcpg_live_your_key_here

# --- both modes ---
MCPGRAM_BASE_URL=https://mcpgram.vercel.app
MCPGRAM_TIMEOUT_MS=30000
MCPGRAM_MAX_RETRIES=2
MCPGRAM_LOG_LEVEL=info

# --- HTTP mode ---
MCPGRAM_HTTP_PORT=3100
MCPGRAM_RATE_LIMIT_MAX=120
MCPGRAM_RATE_LIMIT_WINDOW_MS=60000

# --- Public base URL of THIS deployment (required for OAuth metadata) ---
# e.g. https://mcpgram-mcp-server.vercel.app
MCP_PUBLIC_URL=https://mcpgram-mcp-server.vercel.app

# --- OAuth 2.1 (Claude.ai custom connectors) ---
# openssl rand -hex 32
OAUTH_JWT_SECRET=

# Supabase project (same as MCPGRAM dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — used to create workspace API keys after OAuth consent
SUPABASE_SERVICE_ROLE_KEY=
