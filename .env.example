# MCPGRAM backend (tool execution)
MCPGRAM_BASE_URL=https://mcpgram.vercel.app
MCPGRAM_RATE_LIMIT_MAX=120
MCPGRAM_RATE_LIMIT_WINDOW_MS=60000

# Public URL of this MCP + OAuth server (no trailing slash)
MCP_PUBLIC_URL=https://mcpgram-mcp-server.vercel.app

# HMAC secret for OAuth client_ids, auth codes, access/refresh tokens (min 16 chars)
OAUTH_JWT_SECRET=change-me-to-a-long-random-string

# Supabase — consent login (Google/GitHub/email) + workspace API key issuance
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encrypt workspace API keys stored for OAuth sessions (32+ byte secret)
MCPGRAM_KEY_SECRET=change-me-another-long-random-secret
